{
  "name": "suprkandi",
  "version": "0.1.0",
  "description": "Open-source hybrid testing and RPA platform with plain-English DSL, web, desktop, database automation, and automatic evidence reporting.",
  "main": "src/engine.js",
  "type": "commonjs",

  "bin": {
    "kandi": "bin/kandi.js"
  },

  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],

  "scripts": {
    "start": "node bin/kandi.js --help",
    "test": "node --test",
    "sample": "node bin/kandi.js automate workspaces/test.txt",
    "audit": "node bin/kandi.js audit ManualAudit",
    "pack:check": "npm pack --dry-run"
  },

  "engines": {
    "node": ">=22.12.0"
  },

  "keywords": [
    "test-automation",
    "testing",
    "qa",
    "rpa",
    "selenium",
    "webdriver",
    "webdriver-bidi",
    "desktop-automation",
    "robotjs",
    "database-testing",
    "plain-english",
    "dsl",
    "evidence-reporting",
    "automation-framework"
  ],

  "license": "Apache-2.0",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/suprajak01-sup/suprkandi.git"
  },

  "bugs": {
    "url": "https://github.com/suprajak01-sup/suprkandi/issues"
  },

  "homepage": "https://github.com/suprajak01-sup/suprkandi#readme",

  "publishConfig": {
    "access": "public"
  },

  "dependencies": {
    "commander": "15.0.0",
    "docx": "9.8.1",
    "mysql2": "3.24.5",
    "pg": "8.23.1",
    "robotjs": "0.9.1",
    "screenshot-desktop": "1.15.6",
    "selenium-webdriver": "4.50.0"
  }
}